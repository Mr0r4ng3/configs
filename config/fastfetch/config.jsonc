{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    },
    "percent": {
      "type": 3
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
